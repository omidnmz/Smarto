# Required
DATABASE_URL=postgres://user:password@host:5432/smarto
SESSION_SECRET=a-long-random-string
# Your mobile number; this account becomes the platform admin. Several numbers: comma-separated.
ADMIN_PHONE=09xxxxxxxxx

# Optional
# DATABASE_SSL=true
# Kavenegar (SMS). Without these, login codes are printed in the server log.
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=
# SEED_SAMPLES=false
# PORT=3000
